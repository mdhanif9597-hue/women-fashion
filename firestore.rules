rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }

    match /stock/{stockId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }
    
    match /sales/{saleId} {
      allow read, write: if true;
    }
    
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    
    match /duePayments/{paymentId} {
      allow read, write: if true;
    }
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
